{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Learning Management System",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @platform/database generate",
    "db:migrate": "pnpm --filter @platform/database migrate:dev",
    "db:push": "pnpm --filter @platform/database db:push",
    "db:seed": "pnpm --filter @platform/database seed",
    "db:studio": "pnpm --filter @platform/database studio",
      "db:reset-users": "pnpm --filter @platform/database reset:users",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "turbo": "^2.10.8"
  }
}
