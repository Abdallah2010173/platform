# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://platform:platform_secret@localhost:5432/platform_lms?schema=public"

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (Phase 2+) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Platform LMS

# ─── Production Deployment ───────────────────────────────────────────────────
# DATABASE_URL is REQUIRED and must be injected into the runtime environment
# (Railway / Docker / Kubernetes). The .env file is gitignored and NOT shipped
# in the image — so a value that works locally will silently disappear in prod.
# No database URL is hardcoded anywhere in the codebase.
#
# The value MUST start with "postgresql://" or "postgres://", with no literal
# quotes and no placeholder (e.g. "changeme"). For managed Postgres hosts
# (Supabase, Neon, RDS) append ?sslmode=require or equivalent if required.
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
#
# If DATABASE_URL is missing or malformed, the database package fails fast with
# a clear error instead of letting Prisma fail obscurely on connect.
</content>
