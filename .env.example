# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://platform:platform_secret@localhost:5432/platform_lms?schema=public"

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (Phase 2+) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Platform LMS
