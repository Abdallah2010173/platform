// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Enterprise LMS Platform
// FEATURE 02 · Database Architecture
//
// Conventions:
//   • PostgreSQL + Prisma ORM
//   • UUID primary keys on every table
//   • createdAt / updatedAt / deletedAt on every model (soft delete)
//   • Normalized relations, cascade rules where appropriate
//   • Composite + single-column indexes tuned for millions of users
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

