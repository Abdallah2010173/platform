# =============================================================================
# Platform LMS - Next.js Environment Variables
# =============================================================================
# This file contains EXAMPLE environment variables only.
# Do NOT put real secrets or production credentials here.
# Create a local .env file (or configure your hosting platform) with the
# appropriate values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Public API base URL (no trailing slash)
# Local:
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production example:
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------

# Google OAuth endpoint on the API.
# If omitted, the frontend can derive it from:
# ${NEXT_PUBLIC_API_URL}/auth/google
NEXT_PUBLIC_GOOGLE_REDIRECT_URL=http://localhost:4000/api/v1/auth/google

# Production example:
# NEXT_PUBLIC_GOOGLE_REDIRECT_URL=https://api.example.com/api/v1/auth/google

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_APP_URL=https://platform.example.com

# Application Name
NEXT_PUBLIC_APP_NAME=Platform LMS

# UploadThing server token (keep this secret; do not expose it as NEXT_PUBLIC_*)
UPLOADTHING_TOKEN=replace-with-your-uploadthing-token